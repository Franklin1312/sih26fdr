# SIH26265 Security Deposit / FDR Management Portal
# Copy to .env and fill in values

# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-32-characters-minimum-length-required
JWT_SECRET=change-me-32-characters-minimum-length-required
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Demo mode (allows simple bearer tokens for testing)
DEMO_MODE=true

# Database
# Development: SQLite
DATABASE_URL=sqlite+aiosqlite:///./data/sih26265.db
# Production: PostgreSQL
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/sih26265

# Redis (for caching, sessions, background jobs)
REDIS_URL=redis://localhost:6379/0

# File storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=10

# OCR (optional - requires tesseract installed)
OCR_ENABLED=false
TESSERACT_CMD=tesseract

# Alerts scheduler
ALERT_CHECK_INTERVAL_HOURS=24
ALERT_LEAD_DAYS=30,15,7,1,0

# Audit
AUDIT_CHECKPOINT_INTERVAL=100
AUDIT_CHECKPOINT_KEY_PATH=./data/audit_checkpoint_key.pem

# Email (stub - logs only in demo)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@sih26265.demo

# CORS
CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
CORS_ALLOW_CREDENTIALS=true